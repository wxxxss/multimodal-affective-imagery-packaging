{
  "contract_version": "p9_v1.0",
  "raster": {
    "exif_transpose": true,
    "first_decoded_frame": true,
    "mode": "RGB",
    "preserve_aspect_ratio": true,
    "longest_side_pixels": 512,
    "resample": "LANCZOS",
    "crop": false,
    "segmentation": false,
    "background_removal": false
  },
  "classical_feature_count": 20,
  "classical_features": [
    {"name": "luminance_mean", "definition": "mean(0.2126R + 0.7152G + 0.0722B)"},
    {"name": "luminance_std", "definition": "std(0.2126R + 0.7152G + 0.0722B)"},
    {"name": "luminance_p10", "definition": "p10(0.2126R + 0.7152G + 0.0722B)"},
    {"name": "luminance_p90", "definition": "p90(0.2126R + 0.7152G + 0.0722B)"},
    {"name": "saturation_mean", "definition": "mean(HSV saturation)"},
    {"name": "saturation_std", "definition": "std(HSV saturation)"},
    {"name": "colorfulness_hs", "definition": "sqrt(std(R-G)^2 + std(0.5(R+G)-B)^2) + 0.3*sqrt(mean(R-G)^2 + mean(0.5(R+G)-B)^2)"},
    {"name": "high_saturation_fraction", "definition": "fraction(HSV saturation >= 0.65)"},
    {"name": "near_white_fraction", "definition": "fraction(R>=0.90 and G>=0.90 and B>=0.90)"},
    {"name": "near_black_fraction", "definition": "fraction(R<=0.10 and G<=0.10 and B<=0.10)"},
    {"name": "warm_hue_fraction", "definition": "chromatic fraction in [330,360) union [0,60) degrees"},
    {"name": "cool_hue_fraction", "definition": "chromatic fraction in [150,270] degrees"},
    {"name": "hue_entropy", "definition": "12-bin chromatic hue entropy divided by log(12)"},
    {"name": "grayscale_entropy", "definition": "64-bin luminance entropy divided by log(64)"},
    {"name": "edge_density", "definition": "fraction(sqrt(gx^2+gy^2) >= 0.10)"},
    {"name": "edge_strength_mean", "definition": "mean(sqrt(gx^2+gy^2))"},
    {"name": "lr_symmetry", "definition": "clip(1 - mean(abs(gray - left_right_flip(gray))), 0, 1)"},
    {"name": "tb_symmetry", "definition": "clip(1 - mean(abs(gray - top_bottom_flip(gray))), 0, 1)"},
    {"name": "center_edge_energy_fraction", "definition": "center 50% gradient magnitude sum / total gradient magnitude sum"},
    {"name": "quadrant_edge_imbalance", "definition": "std of four quadrant gradient-energy proportions"}
  ],
  "semantic_feature_count": 16,
  "semantic_features": [
    {"name": "leaf_herb_illustration_score", "prompt_template_count": 3},
    {"name": "floral_illustration_score", "prompt_template_count": 3},
    {"name": "fruit_motif_score", "prompt_template_count": 3},
    {"name": "ingredient_photography_score", "prompt_template_count": 3},
    {"name": "character_mascot_score", "prompt_template_count": 3},
    {"name": "sparse_layout_score", "prompt_template_count": 3},
    {"name": "dense_ornament_score", "prompt_template_count": 3},
    {"name": "heritage_ornament_score", "prompt_template_count": 3},
    {"name": "geometric_layout_score", "prompt_template_count": 3},
    {"name": "kraft_craft_score", "prompt_template_count": 3},
    {"name": "ribbon_bow_box_cues_score", "prompt_template_count": 3},
    {"name": "pale_pastel_palette_score", "prompt_template_count": 3},
    {"name": "vivid_multicolor_palette_score", "prompt_template_count": 3},
    {"name": "typography_dominant_score", "prompt_template_count": 3},
    {"name": "image_dominant_score", "prompt_template_count": 3},
    {"name": "transparent_window_score", "prompt_template_count": 3}
  ],
  "semantic_scores_are": "semantic design similarity scores, not presence probabilities or human gold labels"
}
